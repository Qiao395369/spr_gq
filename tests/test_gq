####################################################################################
# Generic tests for various transformation properties of the wavefunction ansatz.
####################################################################################


def logpsi_transl(logpsi_fn,xp, xe, params):
    _, dim = xe.shape

    logpsi = logpsi_fn(params, xp, xe)
    print("\nlogpsi:", logpsi)

    print("---- Test translation invariance: Psi(x + a) = Psi(x), where `a` is a common translation of both electrons and protons ----")
    shift = jnp.array( np.random.randn(dim) )
    logpsi_shift = logpsi_fn( params, xp + shift, xe + shift,)
    print("logpsi_shift:", logpsi_shift)
    assert jnp.allclose(logpsi_shift, logpsi)

def logpsi_perm(logpsi_fn, xp,xe,params):
    npp, _ = xp.shape
    ne, _ = xe.shape
    logpsi = logpsi_fn( params, xp,xe )
    print("\nlogpsi:", logpsi)

    # print("---- Test invariance under permutation of protons: Psi(Pxp) = Psi(xp) ----")
    # Pp = np.random.permutation(npp)
    # logpsi_Pp = logpsi_fn(params, xp[Pp],xe )
    # print("logpsi_Pp:", logpsi_Pp)
    # assert log_allclose(logpsi_Pp, logpsi)

    print("---- Test antisymmetry under permutation of electrons: Psi(Pxe) = +/- Psi(xe) ----")
    Pe = np.concatenate([np.random.permutation(ne//2), 
                         np.random.permutation(ne//2) + ne//2])
    logpsi_Pe = logpsi_fn( params, xp, xe[Pe])
    print("logpsi_Pe:", logpsi_Pe)
    assert log_allclose(logpsi_Pe, logpsi) or log_allclose(logpsi_Pe, logpsi + 1j*jnp.pi)

