def log_allclose(logx, logy):
    return jnp.allclose(logx.real, logy.real) and \
           jnp.allclose(jnp.exp(1j*(logx.imag - logy.imag)), 1.)

def _get_gaoqiao_model(
        nelec,
        charges,
        nspins,
        ndet,
        depth,
        h1,
        h2,
        nh,
        do_complex,
        gq_type,
        ef_construct_features_type,
        envelope_type,
        ef,
        layer_update_scheme,
        attn_params,
        h1_attn_params,
        trimul_params,
        feat_params,
        det_mode,
        gemi_params,
        jastrow_hiddenlayers,
        jastrow_dim,
        RHF,
    ):
    

    params, network_wfn = gaoqiaobuild.build_network(           #orbitals
        n=nelec,  #电子个数
        charges=charges,  #i.e. charges=jnp.asarray([7.,7.])
        nspins=nspins,   #i.e. (7,7)
        key=jax.random.PRNGKey(42), 
        ndet=ndet,  
        depth=depth, 
        h1=h1, 
        h2=h2, 
        nh=nh,
        do_complex=do_complex,
        gq_type=gq_type,
        ef_construct_features_type=ef_construct_features_type,
        envelope_type=envelope_type,
        ef=ef, 
        layer_update_scheme=layer_update_scheme,
        attn=attn_params, 
        h1_attn=h1_attn_params,
        trimul=trimul_params,
        feat_params=feat_params,
        det_mode=det_mode, 
        gemi_params=gemi_params,
        jastrow_hiddenlayers=jastrow_hiddenlayers,
        jastrow_dim=jastrow_dim,
        RHF=RHF,
    )        
    def block_fn(block):
        if not isinstance(block, dict):
            return False
        return set() < set(block.keys()) <= {"w", "b"}

    print("params.shape:\n", jax.tree_util.tree_map(lambda x: x.shape, params))
    print("params.block.shape:\n", jax.tree_util.tree_map(lambda x: x.shape, block_ravel_pytree(block_fn)(params)))
    raveled_params, _ = jax.flatten_util.ravel_pytree(params)
    print("#parameters in the wavefunction model: %d" % raveled_params.size)

    def log_psi_apply(params,xp,xe):
        phase, logabsdet = network_wfn(params,xe,xp) #xe(ne,3),xp(na,3)
        return logabsdet
    
    xe = jnp.array( np.random.uniform(0., 2., (nelec, 3)) )
    xp = jnp.array( np.random.uniform(0., 2., (len(charges), 3)) )

    return log_psi_apply,xp,xe,params

